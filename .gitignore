# Portable dev toolchains (machine-specific, not committed — see ADR-002)
/tools/node/

# Python
.venv/
__pycache__/
*.pyc

# Secrets (Compass API key, vault path) — see .env.example for required shape
.env

# Node / frontend
node_modules/
dist/

# Editor/OS noise
.DS_Store
Thumbs.db

# Claude Code session-local state (background-agent worktree checkouts,
# local dev-server launch config) — machine/session-specific, not committed
.claude/worktrees/
.claude/launch.json

# Dev-session scratch/log output (ad hoc restart/capture/verify logs and
# one-off debug scripts, not real app code or docs)
/.backend_restart*.log
/.baseline_outlook_before.json
/.customer_bodies_with_content.txt
/.recapture_stdout.log
/uvicorn_*.log
/scratchpad/
src/backend/.scratch/
src/backend/*.log
src/backend/_run_full_capture.py
