COMPASS_BASE_URL=
COMPASS_API_KEY=
COMPASS_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
VAULT_PATH=
# Which top-level folders of that vault hold notes, comma-separated, in
# order. Unset means "Work", which is this project's own original layout.
# A vault keeping work and personal notes side by side sets "Work,Personal";
# a vault with no Work folder at all names its own ("Personal"); empty means
# the vault's own directory is the root. The FIRST one is where a note that
# names no root is written, which is every capture Skill.
#
# Left COMMENTED on purpose: an empty value is a real choice (the vault
# itself), so a copied-and-unfilled line would quietly change the layout.
# VAULT_NOTES_ROOTS=Work,Personal
SELF_EMAIL=
HERMES_BASE_URL=
HERMES_HOME_PATH=
SECOND_BRAIN_DATA_PATH=
CORS_ALLOWED_ORIGINS=
