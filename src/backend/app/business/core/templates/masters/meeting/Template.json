{
  "id": "meeting",
  "identity": {
    "strategy": "id"
  },
  "on_missing": "create",
  "allow_create_folder": true,
  "root": {
    "type": "md",
    "own_folder": true,
    "plain_filename": false,
    "on_existing_title": "always_new",
    "frontmatter_defaults": {
      "type": "Meeting",
      "tags": [
        "kind/meeting"
      ]
    },
    "sections": [
      {
        "name": "Summary",
        "access": "machine_write"
      },
      {
        "name": "Quick Notes",
        "access": "machine_write"
      },
      {
        "name": "Related",
        "access": "machine_write"
      },
      {
        "name": "Personal Notes",
        "access": "user_edit"
      },
      {
        "name": "Actions",
        "access": "user_edit"
      }
    ]
  }
}