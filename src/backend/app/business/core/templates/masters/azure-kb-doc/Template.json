{
  "id": "azure-kb-doc",
  "identity": {
    "strategy": "id"
  },
  "on_missing": "create",
  "allow_create_folder": true,
  "root": {
    "type": "md",
    "own_folder": false,
    "plain_filename": false,
    "on_existing_title": "update_section",
    "frontmatter_defaults": {
      "type": "AzureDoc"
    },
    "sections": [
      {
        "name": "Summary",
        "access": "machine_write"
      },
      {
        "name": "Details",
        "access": "machine_write"
      }
    ]
  }
}
